<nav class="border-b border-gray-200 bg-white" data-controller="toggler">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between">
      <div class="flex flex-shrink-0 items-center">
        <%= image_tag 'logo.png', class: 'block h-16 w-auto' %>
      </div>
      <div class="sm:-my-px sm:ml-14 sm:flex sm:space-x-8 pt-4 sm:text-2xl font-bold vads-font-size-xl justify-center sm:pl-32">VA Mobile Feedback Hub</div>
      <div class="flex">
        <div class="max-sm:hidden sm:-my-px sm:ml-6 sm:flex sm:space-x-8">
          <% links.each do |link_hash| %>
            <%= link_to link_hash[:text],
                        link_hash[:href],
                        class: 'border-transparent text-gray-500 inline-flex items-center border-b-2 px-1 pt-1 text-sm font-medium',
                        data: {
                          controller: 'current-url',
                          current_url_path_value: link_hash[:href],
                          current_url_current_class: 'border-indigo-500 text-gray-900',
                          current_url_not_current_class: 'border-transparent text-gray-500',
                        }
            %>
          <% end %>
        </div>
      </div>
      <div class="hidden sm:ml-6 sm:flex sm:items-center">
      </div>
      <div class="-mr-2 flex items-center sm:hidden">
        <!-- Mobile menu button -->
        <button type="button" class="relative inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" aria-controls="mobile-menu" aria-expanded="false" data-action="toggler#toggle">
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          <!-- Menu open: "hidden", Menu closed: "block" -->
          <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-toggler-target="listener" data-transition-enter='hidden' data-transition-enter-final="hidden" data-transition-leave-final>

            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
          </svg>
          <!-- Menu open: "block", Menu closed: "hidden" -->
          <svg class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-toggler-target="listener" data-transition-leave="hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu, show/hide based on menu state. -->
  <div class="sm:hidden hidden" id="mobile-menu" data-toggler-target="listener">
    <div class="space-y-1 pb-3 pt-2">
      <% links.each do |link_hash| %>

        <%= link_to link_hash[:text],
                    link_hash[:href],
                    class: 'border-transparent text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-800 block border-l-4 py-2 pl-3 pr-4 text-base font-medium',
                    data: {
                      controller: 'current-url',
                      current_url_path_value: link_hash[:href],
                      current_url_current_class: 'border-indigo-500 bg-indigo-50 text-indigo-700',
                      current_url_not_current_class: 'border-transparent text-gray-600',
                    }
        %>
      <% end %>
    </div>
  </div>
</nav>
