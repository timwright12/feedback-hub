<footer class="bg-white w-full">
  <div class="mx-auto max-w-7xl overflow-hidden px-6 py-20 sm:py-24 lg:px-8">
    <nav class="-mb-6 columns-2 sm:flex sm:justify-center sm:space-x-12" aria-label="Footer">
      <% links.each do |link| %>
        <div class="pb-6">
          <%= link_to link[:text], link[:href], aria: link[:aria], class: 'text-sm leading-6 text-gray-600 hover:text-gray-900' %>
        </div>
      <% end %>
    </nav>
    <p class="mt-10 text-center text-xs leading-5 text-gray-500">&copy; <%= Time.now.year %> Ad Hoc. All rights
      reserved.</p>
  </div>
</footer>
